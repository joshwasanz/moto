{%- comment -%} Motor Re Cycle — split hero: bold text + services on one side, photo on the other. {%- endcomment -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800&display=swap">

<section class="mrc-hero">
  <div class="mrc-hero__text">
    {%- if section.settings.eyebrow != blank -%}<p class="mrc-hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="mrc-hero__title">
      {{- section.settings.line_1 }}<br>{{ section.settings.line_2 }}<br><span>{{ section.settings.line_3 }}</span>
    </h1>
    {%- if section.settings.text != blank -%}<p class="mrc-hero__lead">{{ section.settings.text }}</p>{%- endif -%}
    <ul class="mrc-hero__list">
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
    </ul>
    <div class="mrc-hero__btns">
      {%- if section.settings.btn_1 != blank -%}<a class="mrc-btn mrc-btn--white" href="{{ section.settings.btn_1_link }}">{{ section.settings.btn_1 }}</a>{%- endif -%}
      {%- if section.settings.btn_2 != blank -%}<a class="mrc-btn mrc-btn--grey" href="{{ section.settings.btn_2_link }}">{{ section.settings.btn_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="mrc-hero__media">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1600' }}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .mrc-hero { display: flex; flex-wrap: wrap; min-height: 680px; background: #0b0b0c; color: #fff; }
  .mrc-hero__text { flex: 1 1 520px; box-sizing: border-box; padding: 72px 4% 96px; display: flex; flex-direction: column; justify-content: center; gap: 24px; }
  .mrc-hero__eyebrow { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .32em; text-transform: uppercase; color: #d4d4d4; }
  .mrc-hero__eyebrow::before { content: ""; display: inline-block; width: 36px; height: 3px; margin-right: 12px; vertical-align: middle; background: #e2582b; }
  .mrc-hero__title { margin: 0; font: italic 800 clamp(64px, 8vw, 112px)/.86 'Barlow Condensed', sans-serif; text-transform: uppercase; color: #fff; }
  .mrc-hero__title span { color: #e2582b; }
  .mrc-hero__lead { margin: 0; max-width: 520px; font-size: 20px; line-height: 1.5; color: #e5e5e5; }
  .mrc-hero__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 14px; }
  .mrc-hero__list li { display: flex; align-items: center; gap: 14px; font-size: 17px; font-weight: 700; }
  .mrc-hero__list li::before { content: "✓"; flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: #e2582b; color: #0b0b0c; font-weight: 800; }
  .mrc-hero__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .mrc-hero__media { flex: 1 1 520px; position: relative; min-height: 460px; overflow: hidden; }
  .mrc-hero__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mrc-hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, #0b0b0c, transparent 30%), linear-gradient(0deg, #0b0b0c, transparent 25%); }
  .mrc-btn { display: inline-flex; align-items: center; height: 54px; padding: 0 28px; border-radius: 4px; font-size: 18px; font-weight: 800; text-decoration: none; }
  .mrc-btn--white { background: #fff; color: #0b0b0c; }
  .mrc-btn--grey { background: rgba(109,109,110,.7); color: #fff; }
  .mrc-btn--ember { background: #e2582b; color: #0b0b0c; }
  .mrc-btn--wa { background: #25d366; color: #0b0b0c; }
  .mrc-btn:hover { filter: brightness(1.1); }
{% endstylesheet %}

{% schema %}
{
  "name": "MRC hero",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Specialist in Triumph motorcycles" },
    { "type": "text", "id": "line_1", "label": "Headline line 1", "default": "Parts." },
    { "type": "text", "id": "line_2", "label": "Headline line 2", "default": "Paint." },
    { "type": "text", "id": "line_3", "label": "Headline line 3 (orange)", "default": "Passion." },
    { "type": "text", "id": "text", "label": "Tagline", "default": "Everything your Triumph 400 needs, in one place." },
    { "type": "text", "id": "btn_1", "label": "Button 1", "default": "Shop all" },
    { "type": "url", "id": "btn_1_link", "label": "Button 1 link", "default": "/collections/all" },
    { "type": "text", "id": "btn_2", "label": "Button 2", "default": "Contact us" },
    { "type": "url", "id": "btn_2_link", "label": "Button 2 link" }
  ],
  "blocks": [
    { "type": "service", "name": "Service", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "New & open-box parts" } ] }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "MRC hero",
      "blocks": [
        { "type": "service", "settings": { "text": "New & open-box parts" } },
        { "type": "service", "settings": { "text": "Used & refurbished parts" } },
        { "type": "service", "settings": { "text": "Custom-painted fuel tanks" } }
      ]
    }
  ]
}
{% endschema %}
